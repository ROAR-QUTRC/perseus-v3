	)
	(text "I_TRIP = V_VREF / (R_IPROPI * A_IPROPI)\nI_TRIP = 3.3 / (1k3 * 447u) = 5.679 A\nR_IPROPI <= V_ADC / (I_TRIP * A_IPROPI)\n\n*A_IPROPI varies with temp, ranges 443u-450u\n With 1% tolerance, I_TRIP ranges 5.585-5.788 A"
		(exclude_from_sim no)
		(at 128.27 57.912 0)
		(effects
