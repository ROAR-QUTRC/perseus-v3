<?xml version="1.0"?>
<robot name="lidar" xmlns:xacro="http://ros.org/wiki/xacro">

<!--
  Gazebo-only description of the Livox MID-360: the gpu_lidar that stands in for the
  scanner and the IMU inside the housing. The livox_frame link they attach to is part
  of the mast, so it lives in sensor_mount.urdf.xacro next to the joint that aims it.
-->

<!-- Simulating the Livox MID-360 -->
<gazebo reference="${prefix}livox_frame">
  <material>
    <ambient>0.1 0.1 0.1 1</ambient>
    <diffuse>0.1 0.1 0.1 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular>
  </material>
  <sensor name="${prefix}lidar_sensor" type="gpu_lidar">
    <topic>scan_3d</topic>
    <update_rate>50</update_rate>
    <always_on>false</always_on>
    <visualize>false</visualize>
    <ray>
      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
        <!-- Angle Simulating the Livox MID-360 -->
        <vertical> 
          <samples>32</samples>
          <min_angle>-0.1222</min_angle>     <!-- –7° in radians -->
          <max_angle>0.9076</max_angle>      <!-- +52° in radians -->
        </vertical>
      </scan>
      <range>
        <min>0.20</min>
        <max>30.0</max>
        <resolution>0.013</resolution>
      </range>
    </ray>
    <gz_frame_id>${prefix}livox_frame</gz_frame_id>
  </sensor>
</gazebo>

<gazebo reference="${prefix}livox_frame">
    <material>Gazebo/Grey</material>
    <sensor name="${prefix}lidar_imu" type="imu">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>/scan_3d/imu</topic>
        <!-- Add frame id to imu sensor (achieving correct frame association)-->
        <gz_frame_id>${prefix}livox_frame</gz_frame_id>
    </sensor>
</gazebo>


</robot>
