<?xml version="1.0"?>
<robot name="sensor_mount" xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    Mast at the front of the chassis carrying the Livox MID-360 and the RealSense D455.

    The chassis link origin sits at the middle of its front face, at the bottom: its
    collision box is centred at (-chassis_length/2, 0, chassis_height/2), so the body
    extends backwards in -x and upwards in +z from that origin. "Front of the chassis,
    a bit above" is therefore x near 0 and z a little over chassis_height.

    Both sensors hang off sensor_mount rather than off chassis (the Livox through
    livox_base), so re-siting the mast only means changing sensor_mount_*_offset.
  -->
  <xacro:macro name="sensor_mount" params="prefix:=^">
    <link name="${prefix}sensor_mount">
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="${sensor_mount_mass}"/>
        <xacro:box_inertia m="${sensor_mount_mass}" x="${sensor_mount_length}" y="${sensor_mount_width}" z="${sensor_mount_height}"/>
      </inertial>

      <visual>
        <origin xyz="${-0.023} ${0.005} ${-0.035}" rpy="0.0 0.0 ${pi/2}"/>
        <geometry>
          <mesh scale="1.0 1.0 1.0" filename="file://$(find description)/meshes/sensor_mount.dae"/>
        </geometry>
      </visual>
    </link>

    <joint name="${prefix}sensor_mount_joint" type="fixed">
      <parent link="${prefix}chassis"/>
      <child link="${prefix}sensor_mount"/>
      <origin xyz="${sensor_mount_x_offset} ${sensor_mount_y_offset} ${sensor_mount_z_offset}" rpy="0.0 0.0 0.0"/>
    </joint>

    <!--
      Plate on top of the mast that the Livox bolts onto. lidar_angle is applied here, and
      the sensor is fixed to the plate, so the two tilt together: a positive pitch about +y
      takes the plate, and with it the sensor +x axis, towards -z, pointing the LiDAR
      forwards and down. Re-aiming the LiDAR means changing lidar_angle and nothing else.
    -->
    <link name="${prefix}livox_base">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${pi/2}"/>
        <geometry>
          <mesh scale="1.0 1.0 1.0" filename="file://$(find description)/meshes/lidar_base.dae"/>
        </geometry>
      </visual>
    </link>
    <joint name="${prefix}livox_base_joint" type="fixed">
      <parent link="${prefix}sensor_mount"/>
      <child link="${prefix}livox_base"/>
      <origin xyz="0.024 0.0 0.061" rpy="0.0 ${lidar_angle} 0.0"/>
    </joint>

    <!--
      Livox MID-360 itself. The mesh and the collision cylinder are offset down by 20 mm
      because the sensor frame sits above the housing floor; the rpy on the visual only
      aligns the exported mesh with that frame.
    -->
    <link name="${prefix}livox_frame">
      <inertial>
        <origin xyz="0 0.0 0.0" rpy="${pi/2} 0.0 ${pi}"/>
        <mass value="${livox_mass}"/>
        <xacro:box_inertia m="${livox_mass}" x="${livox_length}" y="${livox_radius}" z="${livox_radius}"/>
      </inertial>
      <visual>
        <origin xyz="0 0.0 -0.02" rpy="${pi/2} 0.0 ${pi}"/>
        <geometry>
          <mesh scale="1.0 1.0 1.0" filename="file://$(find description)/meshes/mid-360.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0.0 -0.02" rpy="0.0 0.0 0.0"/>
        <geometry>
          <cylinder radius="${livox_radius}" length="${livox_length}"/>
        </geometry>
      </collision>
    </link>

    <!--
      Livox MID-360, seated on livox_base. The joint only offsets it across the plate and
      adds no rotation of its own, so the sensor inherits the plate's tilt. The IMU-LiDAR
      extrinsic in the fast_lio config is internal to the sensor housing and is unaffected
      by how the housing is mounted.
    -->
    <joint name="${prefix}laser_joint" type="fixed">
      <parent link="${prefix}livox_base"/>
      <child link="${prefix}livox_frame"/>
      <origin xyz="${-0.08} 0.0 0.05" rpy="${0.0} 0.0 ${0.0}"/>
    </joint>

    <!-- RealSense D455, on the front face of the mast, looking straight ahead -->
    <xacro:sensor_d455 parent="${prefix}sensor_mount" name="camera" use_nominal_extrinsics="true">
      <origin xyz="0.035 0.0 0.006" rpy="0.0 0.0 0.0"/>
    </xacro:sensor_d455>
    <xacro:camera_d455_gazebo name="camera"/>
  </xacro:macro>

</robot>
