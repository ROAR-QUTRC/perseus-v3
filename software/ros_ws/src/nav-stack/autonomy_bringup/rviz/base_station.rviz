    LayoutPath: ""
    Name: Arena Minimap
    Topic: /arena/robot_pose
  - Class: rviz_plugins/MobilityEfficiencyPanel
    Name: Mobility Efficiency
    Topic: /watchdog/mobility_status
    WarnPercent: 60
