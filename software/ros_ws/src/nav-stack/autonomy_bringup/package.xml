<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autonomy_bringup</name>
  <version>0.0.1</version>
  <description>ROAR autonomy_bringup software control stack</description>
  <maintainer email="1388693+DingoOz@users.noreply.github.com">Nigel H-S</maintainer>
  
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>slam_toolbox</depend>
  <depend>navigation2</depend>
  <depend>xacro</depend>
  <depend>robot_localization</depend>
  <!-- The two LiDAR-inertial odometry backends localisation.launch.py selects between
       with lio:=bievr (the default) or lio:=fast_lio. Both are exec dependencies only,
       kept as <depend> to match the rest of this file. -->
  <depend>fast-lio</depend>
  <depend>bievr_lio_ros2</depend>
  <depend>watchdog</depend>
  <depend>footprint_broadcaster</depend>
  <depend>arena_server</depend>
  <depend>global_traversability</depend>
  <depend>local_traversability</depend>
  <!-- health_monitor, launched alongside localisation -->
  <depend>health_check</depend>
  <!-- imu_processors components and point_cloud_compress.launch.py, both brought up by
       localisation.launch.py, plus livox.launch.py and realsense.launch.py under
       enable_sensors:=true -->
  <depend>sensors</depend>
  <!-- stereo_odometry, the EKF's odom1. localisation.launch.py runs it either as vision's
       own standalone launch file or, with enable_sensors:=true, by loading the
       vision::StereoOdometry component into the RealSense driver's container. The plugin
       is resolved by name at runtime, so nothing here links against it. -->
  <exec_depend>vision</exec_depend>
  <!-- supplies the Topic Health RViz panel used by base_station.rviz -->
  <depend>rviz_plugins</depend>


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
