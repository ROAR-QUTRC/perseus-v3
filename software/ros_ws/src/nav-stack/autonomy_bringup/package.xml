<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autonomy_bringup</name>
  <version>0.0.1</version>
  <description>ROAR autonomy_bringup software control stack</description>
  <maintainer email="1388693+DingoOz@users.noreply.github.com">Nigel H-S</maintainer>
  
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>slam_toolbox</depend>
  <depend>navigation2</depend>
  <depend>xacro</depend>
  <depend>robot_localization</depend>
  <!-- The LiDAR-inertial odometry localisation.launch.py runs. An exec dependency only,
       kept as <depend> to match the rest of this file. -->
  <depend>bievr_lio_ros2</depend>
  <depend>watchdog</depend>
  <depend>footprint_broadcaster</depend>
  <depend>arena_server</depend>
  <depend>global_traversability</depend>
  <depend>local_traversability</depend>
  <!-- health_monitor, launched alongside localisation -->
  <depend>health_check</depend>
  <!-- imu_processors components and point_cloud_compress.launch.py, both brought up by
       localisation.launch.py, plus livox.launch.py under enable_sensors:=true -->
  <depend>sensors</depend>
  <!-- vision.launch.py, which localisation.launch.py includes for stereo_odometry, the
       EKF's odom1: standalone, or with enable_sensors:=true composed into the RealSense
       driver's container. Launched by name at runtime, so nothing here links against it. -->
  <exec_depend>vision</exec_depend>
  <!-- controller.launch.py, the joystick override base_station.launch.py brings up -->
  <exec_depend>teleop</exec_depend>
  <!-- supplies the Topic Health RViz panel used by base_station.rviz -->
  <depend>rviz_plugins</depend>


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
