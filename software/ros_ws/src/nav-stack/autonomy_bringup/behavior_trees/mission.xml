<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="DigBucket">
    <Sequence>
      <Script code="phase:=&apos;collect&apos;"/>
      <SubTree ID="collect"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="DigOnly">
    <Sequence>
      <SubTree ID="DigBucket"
               _autoremap="true"/>
      <Script code="phase:=&apos;done&apos;"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="DumpBucket">
    <Sequence>
      <Script code="phase:=&apos;dump&apos;"/>
      <SubTree ID="dump"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="DumpOnly">
    <Sequence>
      <SubTree ID="DumpBucket"
               _autoremap="true"/>
      <Script code="phase:=&apos;done&apos;"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="FullAutonomyCycle">
    <Sequence>
      <SubTree ID="GoToExcavation"
               _autoremap="true"/>
      <Repeat num_cycles="{cycles}">
        <Sequence>
          <SubTree ID="DigBucket"
                   _autoremap="true"/>
          <SubTree ID="GoToConstruction"
                   _autoremap="true"/>
          <SubTree ID="DumpBucket"
                   _autoremap="true"/>
          <SubTree ID="GoToExcavation"
                   _autoremap="true"/>
          <Script code="cycles_done += 1"/>
        </Sequence>
      </Repeat>
      <Script code="phase:=&apos;done&apos;"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="GoToConstruction">
    <Sequence>
      <Script code="phase:=&apos;to_construction&apos;"/>
      <IfThenElse>
        <ScriptCondition code="use_arena_construction"/>
        <Sequence>
          <RequestZoneWaypoint goal="{construction_goal}"
                               server_timeout=""
                               service_name="{construction_service}"/>
          <NavigateToPose goal="{construction_goal}"
                          behavior_tree=""
                          error_code_id=""
                          server_timeout=""
                          server_name=""/>
        </Sequence>
        <NavigateToPose goal="{construction_point}"
                        behavior_tree=""
                        error_code_id=""
                        server_timeout=""
                        server_name=""/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="GoToExcavation">
    <Sequence>
      <Script code="phase:=&apos;to_excavation&apos;"/>
      <IfThenElse>
        <ScriptCondition code="use_arena_excavation"/>
        <Sequence>
          <RequestZoneWaypoint goal="{excavation_goal}"
                               server_timeout=""
                               service_name="{excavation_service}"/>
          <NavigateToPose goal="{excavation_goal}"
                          behavior_tree=""
                          error_code_id=""
                          server_timeout=""
                          server_name=""/>
        </Sequence>
        <NavigateToPose goal="{excavation_point}"
                        behavior_tree=""
                        error_code_id=""
                        server_timeout=""
                        server_name=""/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="JawMove">
    <Fallback>
      <MoveBucket failure="{jaw_failure}"
                  server_name="{action}"
                  duration_s=""
                  tolerance_deg=""
                  attempts="1"
                  timeout_s="{move_s}"
                  jaw_deg="{jaw_deg}"
                  tilt_deg=""
                  lift_deg=""/>
      <Sequence>
        <ScriptCondition code="jaw_failure == &apos;not_reached&apos;"/>
        <BlindJawMove max_s="{jaw_blind_max_s}"
                      duration_s="{blind_s}"
                      speed="{blind_speed}"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <Sequence>
      <IfThenElse>
        <ScriptCondition code="prepare_bucket"/>
        <SubTree ID="PrepareBucket"
                 _autoremap="true"/>
        <AlwaysSuccess/>
      </IfThenElse>
      <IfThenElse>
        <ScriptCondition code="scan_localise"/>
        <SubTree ID="ScanAndLocalise"
                 _autoremap="true"/>
        <AlwaysSuccess/>
      </IfThenElse>
      <Switch6 case_1="full_cycle"
               case_2="nav_cycle"
               case_3="nav_excavation"
               case_4="nav_construction"
               case_5="dump"
               case_6="dig"
               variable="{task}">
        <SubTree ID="FullAutonomyCycle"
                 _autoremap="true"/>
        <SubTree ID="NavigationCycle"
                 _autoremap="true"/>
        <SubTree ID="GoToExcavation"
                 _autoremap="true"/>
        <SubTree ID="GoToConstruction"
                 _autoremap="true"/>
        <SubTree ID="DumpOnly"
                 _autoremap="true"/>
        <SubTree ID="DigOnly"
                 _autoremap="true"/>
        <!-- Switch6 is BT.CPP's widest switch, so the tasks past six hang off its default. -->
        <Switch3 case_1="full_cycle_timed"
                 case_2="nav_dig"
                 case_3="nav_dump"
                 variable="{task}">
          <SubTree ID="TimedAutonomyCycle"
                   _autoremap="true"/>
          <SubTree ID="NavigateAndDig"
                   _autoremap="true"/>
          <SubTree ID="NavigateAndDump"
                   _autoremap="true"/>
          <!-- Unknown task: fail rather than guess. -->
          <AlwaysFailure/>
        </Switch3>
      </Switch6>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="NavigateAndDig">
    <Sequence>
      <SubTree ID="GoToExcavation"
               _autoremap="true"/>
      <SubTree ID="DigBucket"
               _autoremap="true"/>
      <Script code="phase:=&apos;done&apos;"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="NavigateAndDump">
    <Sequence>
      <SubTree ID="GoToConstruction"
               _autoremap="true"/>
      <SubTree ID="DumpBucket"
               _autoremap="true"/>
      <Script code="phase:=&apos;done&apos;"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="NavigationCycle">
    <Sequence>
      <SubTree ID="GoToExcavation"
               _autoremap="true"/>
      <Repeat num_cycles="{cycles}">
        <Sequence>
          <SubTree ID="GoToConstruction"
                   _autoremap="true"/>
          <SubTree ID="GoToExcavation"
                   _autoremap="true"/>
          <Script code="cycles_done += 1"/>
        </Sequence>
      </Repeat>
      <Script code="phase:=&apos;done&apos;"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="PrepareBucket">
    <Sequence>
      <Script code="phase:=&apos;bucket_to_zero&apos;"/>
      <!-- Pose_zero and Pose_travel step by step, so a missed jaw move alone does
           not end the run: it can be recovered later. -->
      <SubTree ID="Pose_zero_lift"/>
      <SubTree ID="Pose_zero_tilt"/>
      <Fallback>
        <SubTree ID="Pose_zero_jaw"/>
        <AlwaysSuccess/>
      </Fallback>
      <Script code="phase:=&apos;bucket_to_travel&apos;"/>
      <SubTree ID="Pose_travel_lift"/>
      <SubTree ID="Pose_travel_tilt"/>
      <Fallback>
        <SubTree ID="Pose_close"/>
        <AlwaysSuccess/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ScanAndLocalise">
    <Sequence>
      <Script code="phase:=&apos;scan_localise&apos;"/>
      <Fallback>
        <LocaliseInArena timeout_s="{scan_look_s}"
                         server_timeout=""
                         service_name="/arena/localise"/>
        <Sequence>
          <WallSide side=""
                    spin_deg="{scan_spin_deg}"
                    box_x_min_m="-0.775000"
                    range_m="{scan_wall_range_m}"
                    topic="/livox/lidar/cropped"
                    min_clearance_m="{scan_min_clearance_m}"
                    base_frame="base_footprint"
                    z_min_m="0.200000"
                    z_max_m="1.200000"
                    box_half_width_m="0.435000"
                    box_x_max_m="0.900000"
                    spin_dist="{scan_spin_dist}"
                    self_pad_m="0.150000"
                    window_s="0.600000"/>
          <RetryUntilSuccessful num_attempts="{scan_retries}">
            <Sequence>
              <Parallel failure_count="1"
                        success_count="1">
                <ForceFailure>
                  <BlindSpin topic="cmd_vel_nav_stamped"
                             time_allowance_s="{scan_spin_allowance_s}"
                             speed_rad_s="0.400000"
                             spin_dist="{scan_spin_dist}"/>
                </ForceFailure>
                <WaitForMarkers topic="/vision/aruco/detections"
                                min_markers="2"/>
              </Parallel>
              <Wait wait_duration="0.5"
                    server_timeout=""
                    server_name=""/>
              <LocaliseInArena timeout_s="{scan_look_s}"
                               server_timeout=""
                               service_name="/arena/localise"/>
            </Sequence>
          </RetryUntilSuccessful>
          <Fallback>
            <ClearEntireCostmap name="ClearTerrainMemory-Scan"
                                server_timeout=""
                                service_name="global_traversability/clear_region"/>
            <AlwaysSuccess/>
          </Fallback>
          <Wait wait_duration="1.5"
                server_timeout=""
                server_name=""/>
          <Fallback>
            <Sequence>
              <ClearEntireCostmap name="ClearLocalCostmap-Scan"
                                  server_timeout=""
                                  service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Scan"
                                  server_timeout=""
                                  service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <AlwaysSuccess/>
          </Fallback>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TimedAutonomyCycle">
    <Sequence>
      <SubTree ID="GoToExcavation"
               _autoremap="true"/>
      <Repeat num_cycles="{cycles}">
        <Sequence>
          <Script code="phase:=&apos;excavating&apos;"/>
          <Sleep msec="{pause_ms}"/>
          <SubTree ID="GoToConstruction"
                   _autoremap="true"/>
          <Script code="phase:=&apos;depositing&apos;"/>
          <Sleep msec="{pause_ms}"/>
          <SubTree ID="GoToExcavation"
                   _autoremap="true"/>
          <Script code="cycles_done += 1"/>
        </Sequence>
      </Repeat>
      <Script code="phase:=&apos;done&apos;"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BlindJawMove">
      <input_port name="max_s"
                  default="8.000000"
                  type="double">the longest a move may last; duration_s is clamped to it, because a jaw driven into its end stop stalls the motor</input_port>
      <input_port name="duration_s"
                  default="0.000000"
                  type="double">how long to drive the jaw, seconds</input_port>
      <input_port name="speed"
                  default="0.000000"
                  type="double">jaw velocity in bucket_actuators units; the sign is the direction, 0 refuses to move</input_port>
    </Action>
    <Action ID="BlindSpin">
      <input_port name="topic"
                  default="cmd_vel_nav_stamped"
                  type="std::string">twist_mux's navigation input</input_port>
      <input_port name="time_allowance_s"
                  default="40.000000"
                  type="double">fail if the turn takes longer</input_port>
      <input_port name="speed_rad_s"
                  default="0.400000"
                  type="double">turn rate; 0.4 clears the ESCs' stall, as nav2's Spin does</input_port>
      <input_port name="spin_dist"
                  type="double">radians to turn, positive left</input_port>
    </Action>
    <Action ID="ClearEntireCostmap">
      <input_port name="server_timeout"
                  type="std::chrono::milliseconds"/>
      <input_port name="service_name"
                  type="std::string">please_set_service_name_in_BT_Node</input_port>
    </Action>
    <Action ID="LocaliseInArena">
      <input_port name="timeout_s"
                  default="1.500000"
                  type="double">how long arena_server waits for a frame with two markers; &lt;= 0 uses its own default</input_port>
      <input_port name="server_timeout"
                  type="std::chrono::milliseconds"/>
      <input_port name="service_name"
                  type="std::string">please_set_service_name_in_BT_Node</input_port>
    </Action>
    <Action ID="MoveBucket">
      <output_port name="failure"
                   type="std::string">why the move failed, empty on success: invalid, operator_override, no_server, rejected, not_reached (the controller ran but the pose was missed) or timeout</output_port>
      <input_port name="server_name"
                  default="/bucket_trajectory_controller/follow_joint_trajectory"
                  type="std::string">the bucket controller's FollowJointTrajectory action</input_port>
      <input_port name="duration_s"
                  type="double">timed move instead: the controller interpolates over this long; omit for a direct move</input_port>
      <input_port name="tolerance_deg"
                  type="double">how close counts as there; omit for the controller's 2 deg</input_port>
      <input_port name="attempts"
                  default="1"
                  type="int">how many times to send the pose if it is not reached</input_port>
      <input_port name="timeout_s"
                  default="10.000000"
                  type="double">direct move: how long the bucket may take to arrive</input_port>
      <input_port name="jaw_deg"
                  type="double">bucket_jaw_joint target, degrees; omit to hold</input_port>
      <input_port name="tilt_deg"
                  type="double">bucket_tilt_joint target, degrees; omit to hold</input_port>
      <input_port name="lift_deg"
                  type="double">bucket_lift_joint target, degrees; omit to hold</input_port>
    </Action>
    <Action ID="NavigateToPose">
      <input_port name="goal"
                  type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination to plan to</input_port>
      <input_port name="behavior_tree"
                  type="std::string">Behavior tree to run</input_port>
      <output_port name="error_code_id"
                   type="unsigned short">Navigate to pose error code</output_port>
      <input_port name="server_timeout"
                  type="std::chrono::milliseconds"/>
      <input_port name="server_name"
                  type="std::string">Action server name</input_port>
    </Action>
    <Action ID="RequestZoneWaypoint">
      <output_port name="goal"
                   type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Safe point returned by the service, in the arena (map) frame</output_port>
      <input_port name="server_timeout"
                  type="std::chrono::milliseconds"/>
      <input_port name="service_name"
                  type="std::string">please_set_service_name_in_BT_Node</input_port>
    </Action>
    <Action ID="Wait">
      <input_port name="wait_duration"
                  default="1.000000"
                  type="double">Wait time</input_port>
      <input_port name="server_timeout"
                  type="std::chrono::milliseconds"/>
      <input_port name="server_name"
                  type="std::string">Action server name</input_port>
    </Action>
    <Action ID="WaitForMarkers">
      <input_port name="topic"
                  default="/vision/aruco/detections"
                  type="std::string">the ArUco detector's DetectionArray topic</input_port>
      <input_port name="min_markers"
                  default="2"
                  type="int">markers with a 3D pose needed in one frame</input_port>
    </Action>
    <Action ID="WallSide">
      <output_port name="side"
                   type="std::string">left or right</output_port>
      <input_port name="spin_deg"
                  default="360.000000"
                  type="double">size of the turn written to spin_dist</input_port>
      <input_port name="box_x_min_m"
                  default="-0.775000"
                  type="double">the rover's own box, behind base_footprint, before padding</input_port>
      <input_port name="range_m"
                  default="4.000000"
                  type="double">ignore walls farther than this</input_port>
      <input_port name="topic"
                  default="/livox/lidar/cropped"
                  type="std::string">the lidar's PointCloud2</input_port>
      <input_port name="min_clearance_m"
                  default="0.000000"
                  type="double">fail when a wall is nearer than this to the rover's center; 0 or less never fails</input_port>
      <input_port name="base_frame"
                  default="base_footprint"
                  type="std::string">the frame the rover turns about</input_port>
      <input_port name="z_min_m"
                  default="0.200000"
                  type="double">lowest a wall point may be above the ground</input_port>
      <input_port name="z_max_m"
                  default="1.200000"
                  type="double">highest a wall point may be</input_port>
      <input_port name="box_half_width_m"
                  default="0.435000"
                  type="double">either side of base_footprint</input_port>
      <input_port name="box_x_max_m"
                  default="0.900000"
                  type="double">ahead of base_footprint</input_port>
      <output_port name="spin_dist"
                   type="double">spin_deg in radians: positive left, negative right</output_port>
      <input_port name="self_pad_m"
                  default="0.150000"
                  type="double">padding added to that box on every side</input_port>
      <input_port name="window_s"
                  default="0.600000"
                  type="double">how long to gather clouds for</input_port>
    </Action>
  </TreeNodesModel>

</root>
