<!--
  Mission tree behind /mission/start (mission_bt_server, driven by the RViz Mission
  Control panel). Built from go_to_zone_waypoint.xml: GoToExcavation / GoToConstruction
  below are that tree's RequestZoneWaypoint -> NavigateToPose, with a second branch that
  drives straight to a point picked on the map instead of asking arena_server. As there,
  NavigateToPose is nav2's own action-client node into bt_navigator's /navigate_to_pose,
  so planning, smoothing, replanning and recovery are still entirely
  navigate_to_pose_w_smoothing.xml's. This tree only decides where to go and in what order.

  mission_bt_server sets every blackboard entry read here before building the tree:
    task                     "full_cycle" | "nav_cycle" | "nav_excavation" | "nav_construction"
                             | "dump" (no driving: DumpBucket once, where the rover stands)
                             | "dig" (DigBucket once, from where the rover stands)
                             | "full_cycle_timed" (FullAutonomyCycle's drive, a timed
                               stop in place of each bucket step)
    cycles                   int, >= 1
    use_arena_excavation     bool: true asks arena_server, false uses excavation_point
    use_arena_construction   bool, same for construction
    excavation_point         PoseStamped picked in RViz (unused when use_arena_*)
    construction_point       PoseStamped
    excavation_service       arena_server's /arena/request_excavation_waypoint
    construction_service     arena_server's /arena/request_construction_waypoint
    cycles_done              int, 0  this tree counts it up
    pause_ms                 int, how long TimedAutonomyCycle stops at each zone
    prepare_bucket           bool: run PrepareBucket before the task
    bucket_action            the bucket controller's FollowJointTrajectory action
    bucket_travel_lift_deg   the travel pose PrepareBucket ends in, degrees
    bucket_travel_tilt_deg
    bucket_travel_jaw_deg
    bucket_move_s            how long each PrepareBucket move takes, seconds
    dig_*                    DigBucket's angles, creeps and timing; see DigBucket
    phase                    string this tree writes it; the server publishes both on
                             /mission/status as they change

  A cycle is excavation -> construction -> back to excavation, and it is counted on
  arrival back at excavation. The rover drives to excavation once first, so the loop
  body always starts where it digs.

  FullAutonomyCycle digs at excavation with the DigBucket subtree and dumps the load at
  construction with DumpBucket, both below.
-->

<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <Sequence>
      <IfThenElse>
        <ScriptCondition code="prepare_bucket"/>
        <SubTree ID="PrepareBucket" _autoremap="true"/>
        <AlwaysSuccess/>
      </IfThenElse>
      <Switch6 variable="{task}"
               case_1="full_cycle" case_2="nav_cycle"
               case_3="nav_excavation" case_4="nav_construction"
               case_5="dump" case_6="dig">
        <SubTree ID="FullAutonomyCycle" _autoremap="true"/>
        <SubTree ID="NavigationCycle" _autoremap="true"/>
        <SubTree ID="GoToExcavation" _autoremap="true"/>
        <SubTree ID="GoToConstruction" _autoremap="true"/>
        <SubTree ID="DumpOnly" _autoremap="true"/>
        <SubTree ID="DigOnly" _autoremap="true"/>
        <!-- BT.CPP stops at Switch6, so the seventh task is the default branch's
             own check. Anything else is still an unknown task: fail rather than
             guess. -->
        <IfThenElse>
          <ScriptCondition code="task == 'full_cycle_timed'"/>
          <SubTree ID="TimedAutonomyCycle" _autoremap="true"/>
          <AlwaysFailure/>
        </IfThenElse>
      </Switch6>
    </Sequence>
  </BehaviorTree>

  <!--
    Every joint to 0 first - arms level at the top, bucket level, jaws closed - so the
    move to the travel pose always starts from the same place, then the travel pose:
    by default lift 25, tilt -20 (curled), jaw 0, which keeps the bucket out of the
    MID-360's and D455's view of the ground 2 m ahead and beyond while leaving about
    0.17 m of ground clearance. The pose is mission_bt_server's
    bucket_travel_*_deg parameters. A failed move fails the mission before the rover
    drives anywhere.
  -->
  <BehaviorTree ID="PrepareBucket">
    <Sequence>
      <Script code="phase:='bucket_to_zero'"/>
      <MoveBucket lift_deg="0" tilt_deg="0" jaw_deg="0"
                  duration_s="{bucket_move_s}" server_name="{bucket_action}"/>
      <Script code="phase:='bucket_to_travel'"/>
      <MoveBucket lift_deg="{bucket_travel_lift_deg}" tilt_deg="{bucket_travel_tilt_deg}"
                  jaw_deg="{bucket_travel_jaw_deg}"
                  duration_s="{bucket_move_s}" server_name="{bucket_action}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="FullAutonomyCycle">
    <Sequence>
      <SubTree ID="GoToExcavation" _autoremap="true"/>
      <Repeat num_cycles="{cycles}">
        <Sequence>
          <SubTree ID="DigBucket" _autoremap="true"/>
          <SubTree ID="GoToConstruction" _autoremap="true"/>
          <SubTree ID="DumpBucket" _autoremap="true"/>
          <SubTree ID="GoToExcavation" _autoremap="true"/>
          <Script code="cycles_done += 1"/>
        </Sequence>
      </Repeat>
      <Script code="phase:='done'"/>
    </Sequence>
  </BehaviorTree>

  <!--
    Dump the load at the construction zone, then stow the bucket for the drive back.
    Each step is one MoveBucket goal and moves only the joints it names; the others
    hold. Angles in degrees (lift positive lowering, tilt positive dumping, jaw positive
    opening):

      1. lift 20, tilt 20 together   lower the arms and tip the bucket over the pile
      2. jaw 36                      open the clamshell and let the load out
      3. tilt -20                    curl back, emptying what is left
      4. the travel pose, jaw closed lift/tilt/jaw all at once, as PrepareBucket ends

    A step that fails fails the mission there, with the rover still at construction.
  -->
  <BehaviorTree ID="DumpBucket">
    <Sequence>
      <Script code="phase:='dump_lower_tip'"/>
      <MoveBucket lift_deg="20" tilt_deg="20"
                  duration_s="{bucket_move_s}" server_name="{bucket_action}"/>
      <Script code="phase:='dump_open_jaw'"/>
      <MoveBucket jaw_deg="36"
                  duration_s="{bucket_move_s}" server_name="{bucket_action}"/>
      <Script code="phase:='dump_curl'"/>
      <MoveBucket tilt_deg="-20"
                  duration_s="{bucket_move_s}" server_name="{bucket_action}"/>
      <Script code="phase:='dump_stow'"/>
      <MoveBucket lift_deg="{bucket_travel_lift_deg}" tilt_deg="{bucket_travel_tilt_deg}"
                  jaw_deg="{bucket_travel_jaw_deg}"
                  duration_s="{bucket_move_s}" server_name="{bucket_action}"/>
    </Sequence>
  </BehaviorTree>

  <!--
    FullAutonomyCycle with the bucket left alone (StartMission MODE_FULL_AUTONOMY_TIMED):
    the same drives in the same order, with a stop of pause_ms where DigBucket and
    DumpBucket would run. For exercising the whole mission - waypoints, cycle count,
    timing - on a rover with no bucket feedback. The phases are excavating and
    depositing, which the panel shows as timed stops.
  -->
  <BehaviorTree ID="TimedAutonomyCycle">
    <Sequence>
      <SubTree ID="GoToExcavation" _autoremap="true"/>
      <Repeat num_cycles="{cycles}">
        <Sequence>
          <Script code="phase:='excavating'"/>
          <Sleep msec="{pause_ms}"/>
          <SubTree ID="GoToConstruction" _autoremap="true"/>
          <Script code="phase:='depositing'"/>
          <Sleep msec="{pause_ms}"/>
          <SubTree ID="GoToExcavation" _autoremap="true"/>
          <Script code="cycles_done += 1"/>
        </Sequence>
      </Repeat>
      <Script code="phase:='done'"/>
    </Sequence>
  </BehaviorTree>

  <!-- Same loop as FullAutonomyCycle without the bucket steps. -->
  <!--
    Dump only (StartMission MODE_DUMP_ONLY): the same DumpBucket sequence FullAutonomyCycle
    runs at construction, once, wherever the rover is standing. No driving.
  -->
  <BehaviorTree ID="DumpOnly">
    <Sequence>
      <SubTree ID="DumpBucket" _autoremap="true"/>
      <Script code="phase:='done'"/>
    </Sequence>
  </BehaviorTree>

  <!--
    One dig pass from where the rover stands, facing the regolith to be cut. The values
    are mission_bt_server's dig_* parameters; the defaults are in brackets. Angles in
    degrees as above (lift positive lowering, tilt positive tipping down):

      1. tilt [28], jaw 0            cutting edge down, clamshell shut
      2. lift [32]                   arms down until the edge is in the regolith
      3. creep [0.20 m] ahead        at [0.08 m/s], cutting
      4. tilt [-28]                  curl the bucket up to hold the load
      5. creep [0.40 m] ahead        while the arms rise to [0], the carrying pose (arms
                                     level at the top, bucket curled). Both start
                                     together; the lift takes the longer of the drive
                                     and bucket_move_s (dig_carry_s)

    The creeps are nav2's DriveOnHeading (behavior_server's drive_on_heading), so
    they go through the velocity smoother and twist_mux like any nav2 motion, and are
    collision-checked against the local costmap: one that sees an obstacle ahead stops
    and fails the dig. Ends in the carrying pose, lift 0 and tilt -28 with the load;
    the drive to construction and DumpBucket take it from there.
  -->
  <BehaviorTree ID="DigBucket">
    <Sequence>
      <Script code="phase:='dig_tilt'"/>
      <MoveBucket tilt_deg="{dig_tilt_deg}" jaw_deg="0"
                  duration_s="{bucket_move_s}" server_name="{bucket_action}"/>
      <Script code="phase:='dig_lower'"/>
      <MoveBucket lift_deg="{dig_lift_deg}"
                  duration_s="{bucket_move_s}" server_name="{bucket_action}"/>
      <Script code="phase:='dig_push'"/>
      <DriveOnHeading dist_to_travel="{dig_push_m}" speed="{dig_speed}"
                      time_allowance="{dig_push_allowance_s}" server_name="drive_on_heading"/>
      <Script code="phase:='dig_curl'"/>
      <MoveBucket tilt_deg="{dig_curl_tilt_deg}"
                  duration_s="{bucket_move_s}" server_name="{bucket_action}"/>
      <Script code="phase:='dig_carry'"/>
      <Parallel success_count="2" failure_count="1">
        <DriveOnHeading dist_to_travel="{dig_carry_m}" speed="{dig_speed}"
                        time_allowance="{dig_carry_allowance_s}" server_name="drive_on_heading"/>
        <MoveBucket lift_deg="{dig_carry_lift_deg}"
                    duration_s="{dig_carry_s}" server_name="{bucket_action}"/>
      </Parallel>
    </Sequence>
  </BehaviorTree>

  <!--
    Dig only (StartMission MODE_DIG_ONLY): DigBucket once, from where the rover stands.
  -->
  <BehaviorTree ID="DigOnly">
    <Sequence>
      <SubTree ID="DigBucket" _autoremap="true"/>
      <Script code="phase:='done'"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="NavigationCycle">
    <Sequence>
      <SubTree ID="GoToExcavation" _autoremap="true"/>
      <Repeat num_cycles="{cycles}">
        <Sequence>
          <SubTree ID="GoToConstruction" _autoremap="true"/>
          <SubTree ID="GoToExcavation" _autoremap="true"/>
          <Script code="cycles_done += 1"/>
        </Sequence>
      </Repeat>
      <Script code="phase:='done'"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="GoToExcavation">
    <Sequence>
      <Script code="phase:='to_excavation'"/>
      <IfThenElse>
        <ScriptCondition code="use_arena_excavation"/>
        <Sequence>
          <RequestZoneWaypoint service_name="{excavation_service}" goal="{excavation_goal}"/>
          <NavigateToPose goal="{excavation_goal}"/>
        </Sequence>
        <NavigateToPose goal="{excavation_point}"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="GoToConstruction">
    <Sequence>
      <Script code="phase:='to_construction'"/>
      <IfThenElse>
        <ScriptCondition code="use_arena_construction"/>
        <Sequence>
          <RequestZoneWaypoint service_name="{construction_service}" goal="{construction_goal}"/>
          <NavigateToPose goal="{construction_goal}"/>
        </Sequence>
        <NavigateToPose goal="{construction_point}"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

</root>
