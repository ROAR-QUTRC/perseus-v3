<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!--
    Saved bucket poses, one subtree each, for building bucket behaviours in Groot2.

    Written by `ros2 run payloads bucket_teach.py` (p saves the bucket where it stands);
    editing by hand is fine too. Each Pose_<name> is one direct MoveBucket: the setpoint
    jumps to the pose, the board drives there flat out, and a pose missed within timeout_s
    is sent again, up to attempts times. Joints a pose leaves out hold where they are.

    server_name reads {@bucket_action} from the root blackboard, so a pose works however
    it is dropped into a tree, remapped or not.
  -->
  <BehaviorTree ID="Pose_zero">
    <MoveBucket lift_deg="0.0" tilt_deg="0.0" jaw_deg="0.0" timeout_s="10.0" attempts="2" server_name="{@bucket_action}"/>
  </BehaviorTree>
  <BehaviorTree ID="Pose_dump_open">
    <MoveBucket lift_deg="23.8" tilt_deg="-44.7" jaw_deg="24.0" timeout_s="2" attempts="2" server_name="{@bucket_action}"/>
  </BehaviorTree>
  <BehaviorTree ID="Pose_jaw_ready_scoop">
    <MoveBucket lift_deg="26.3" tilt_deg="-13.1" jaw_deg="25.0" timeout_s="4" attempts="2" server_name="{@bucket_action}"/>
  </BehaviorTree>
  <BehaviorTree ID="Pose_jaw_close_scoop">
    <MoveBucket lift_deg="26.7" tilt_deg="-26.0" jaw_deg="0.0" timeout_s="2" attempts="2" server_name="{@bucket_action}"/>
  </BehaviorTree>
  <BehaviorTree ID="Pose_comp_travel">
    <MoveBucket lift_deg="15.5" tilt_deg="-36.9" jaw_deg="0.0" timeout_s="2" attempts="3" server_name="{@bucket_action}"/>
  </BehaviorTree>
  <BehaviorTree ID="Pose_pre_dump">
    <MoveBucket lift_deg="25.8" tilt_deg="-46.7" jaw_deg="0.0" timeout_s="2" attempts="3" server_name="{@bucket_action}"/>
  </BehaviorTree>
  <BehaviorTree ID="Pose_forward_tilt">
    <MoveBucket tilt_deg="-10.3" timeout_s="3" attempts="3" server_name="{@bucket_action}"/>
  </BehaviorTree>
  <BehaviorTree ID="Pose_backward_tilt">
    <MoveBucket tilt_deg="-57.7" timeout_s="3" attempts="2" server_name="{@bucket_action}"/>
  </BehaviorTree>
  <BehaviorTree ID="Pose_collect">
    <MoveBucket lift_deg="37.2" tilt_deg="-27.2" jaw_deg="34.5" timeout_s="3" attempts="3" server_name="{@bucket_action}"/>
  </BehaviorTree>
  <BehaviorTree ID="Pose_close">
    <MoveBucket lift_deg="38.0" tilt_deg="-47.6" jaw_deg="0.0" timeout_s="3" attempts="3" server_name="{@bucket_action}"/>
  </BehaviorTree>
</root>
