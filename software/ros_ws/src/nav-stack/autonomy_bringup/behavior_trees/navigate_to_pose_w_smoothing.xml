<!--
  nav2's navigate_to_pose_w_replanning_and_recovery.xml, with one addition: the planned
  path is smoothed before it reaches the controller.

  WHY. NavFn plans on the costmap grid (resolution_m 0.1 in navigation.yaml), so its paths
  change direction in 45 and 90 degree steps. No physical rover follows a right angle. The
  tightest arc this one can drive is speed / angular_ceiling = 0.15 / 0.4 = 0.38 m, so every
  grid corner had to become either a cut corner or a stop-and-pivot, and tuning the
  controller only moved the problem between those two failures. Smoothing removes the
  corners instead, which is the only fix that addresses the cause.

  The SmoothPath node writes back into the SAME {path} blackboard entry it reads, so
  FollowPath downstream needs no change. It simply receives a better path.

  THE FALLBACK IS DELIBERATE. Smoothing can fail: it is given a 0.2 s budget, and with
  check_for_collisions true it also refuses a smoothed path that clips an obstacle the raw
  one avoided. AlwaysSuccess then lets the tree carry on with the unsmoothed path rather
  than failing the whole navigation. Degraded, not broken: the rover still drives, just
  with the blocky path and the pivoting that goes with it. If cornering gets worse
  mid-run, that is what happened, and smoother_server's log will say why.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="ThetaStar" topic_name="planner_selector"/>
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Sequence>
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
              <Fallback>
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="simple_smoother" max_smoothing_duration="0.2" check_for_collisions="true" error_code_id="{smoother_error_code}"/>
                <AlwaysSuccess/>
              </Fallback>
            </Sequence>
            <Sequence>
              <!-- WouldAPlannerRecoveryHelp says no to START_OCCUPIED (205) and GOAL_OCCUPIED
                   (206), so the tree used to fail the goal within ~30 ms of a "Start occupied"
                   and never tried any recovery. Both are exactly what clearing remembered dust
                   can fix, so accept them here too. ScriptCondition is built into BT.CPP. -->
              <Fallback>
                <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
                <ScriptCondition code="compute_path_error_code == 205 || compute_path_error_code == 206"/>
              </Fallback>
              <!-- Forget the terrain map around the rover FIRST. global_traversability
                   remembers what it has seen, so a false obstacle (dust) that has since
                   settled stays on the map until the lidar looks at that spot again, and
                   clearing only nav2's copy just re-reads it. Failure here is tolerated:
                   the nav2 clear below still runs. (ClearEntireCostmap is only the vehicle:
                   clear_region serves its service type.) -->
              <Fallback>
                <ClearEntireCostmap name="ClearTerrainMemory" service_name="global_traversability/clear_region"/>
                <AlwaysSuccess/>
              </Fallback>
              <!-- clear_region republishes /costmap a moment after it replies, so let that land
                   before nav2's own costmap is cleared and re-read. -->
              <Wait wait_duration="1.5"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              <!-- Start occupied only: the rover is standing on cells the planner refuses to
                   start from. If it was dust, the clear above already fixed it and the retry
                   succeeds. If it is real, back out blind (escape_reverse.py, 0.3 m) so the
                   retry starts from clear ground. Never for a goal-occupied failure. -->
              <Fallback>
                <Sequence>
                  <ScriptCondition code="compute_path_error_code == 205"/>
                  <ClearEntireCostmap name="PlannerEscapeReverse" service_name="escape/reverse"/>
                  <Wait wait_duration="3.0"/>
                </Sequence>
                <AlwaysSuccess/>
              </Fallback>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <!-- BackUp first, and twice per cycle of six retries. When every DWB trajectory
               hits an obstacle the rover is already against one: clearing the costmaps
               only rebuilds it (the terrain nodes re-derive the same cells), and Spin
               sweeps the 1.7 m footprint into it and is refused. Backing out is what
               opens room. BackUp is collision-checked against the local costmap, so a
               blocked rear still refuses and the next recovery runs instead. -->
          <RoundRobin name="RecoveryActions">
            <BackUp backup_dist="0.5" backup_speed="0.15" error_code_id="{backup_code_id}"/>
            <!-- When BackUp refuses with "Collision Ahead" the footprint is already on a lethal
                 cell, and every checked recovery refuses for the same reason. RoundRobin moves
                 on to the next child when one fails, so this runs right after it. It reverses
                 a short fixed distance WITHOUT checking the costmap (escape_reverse.py). No
                 costmap clear after it: the terrain nodes re-derive the same cells, so a clear
                 changes nothing, and moving off them is what lets the next attempt work. The
                 ClearEntireCostmap node is only the vehicle: escape/reverse serves its service
                 type. Blind, because nothing senses behind the rover. -->
            <Sequence name="EscapeActions">
              <ClearEntireCostmap name="EscapeReverse" service_name="escape/reverse"/>
              <!-- escape/reverse answers at once and moves on its own thread (a BT service
                   call is abandoned after tens of ms), so wait out the ~2.3 s reverse here. -->
              <Wait wait_duration="3.0"/>
            </Sequence>
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Spin spin_dist="1.57" error_code_id="{spin_error_code}"/>
            <BackUp backup_dist="0.5" backup_speed="0.15" error_code_id="{backup_code_id}"/>
            <Wait wait_duration="5.0"/>
            <!-- Only here, the LAST step of the list, so it runs after several failed attempts
                 (BackUp, escape, clear, Spin, Wait) have not freed the rover. global_traversability
                 remembers what it has seen, and nav2's clears do not touch that memory. -->
            <Sequence name="ClearingActions2">
              <Fallback>
                <ClearEntireCostmap name="ClearTerrainMemory-Sub2" service_name="global_traversability/clear_region"/>
                <AlwaysSuccess/>
              </Fallback>
              <Wait wait_duration="1.5"/>
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree2" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree2" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
