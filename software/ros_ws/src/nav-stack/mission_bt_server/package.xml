<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_bt_server</name>
  <version>0.0.1</version>
  <description>Runs a small behaviour tree - request a safe zone waypoint from arena_server, then drive there via nav2's NavigateToPose - behind two plain services for the RViz mission panel</description>
  <maintainer email="nguyenleminh1002@gmail.com">Kelvin L.</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>interfaces</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>behaviortree_cpp</depend>
  <depend>nav2_behavior_tree</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
