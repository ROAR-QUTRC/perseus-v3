<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>health_check</name>
  <version>0.0.1</version>
  <description>Rate, bandwidth and link monitoring for the sensing and estimation stack</description>
  <maintainer email="nguyenleminh1002@gmail.com">Kelvin L.</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>interfaces</depend>

  <!-- The RViz panel lives here too, so the package pulls in RViz and Qt. That is a
       deliberate trade: one package to build and install, at the cost of the rover
       dragging in RViz alongside the monitor node. -->
  <depend>rviz_common</depend>
  <depend>pluginlib</depend>
  <depend>qtbase5-dev</depend>

  <exec_depend>iputils</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
