<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>can_logger</name>
  <version>0.0.1</version>
  <description>Logs every CAN frame seen on an interface to a single CSV file, buffering 15000 lines in memory between writes.</description>
  <maintainer email="nguyenleminh1002@gmail.com">Kelvin Le</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hi_can_raw</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
