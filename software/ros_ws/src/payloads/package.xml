<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>payloads</name>
  <version>0.2.1</version>
  <description>Payload-specific nodes and launch files for the Perseus Rover.</description>
  <license>MIT</license>
  <maintainer email="evanfoxx18@gmail.com">Mozz</maintainer>


  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hi_can_raw</depend>
  <depend>actuator_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <!-- <exec_depend>position_controllers</exec_depend> -->
  <!-- <exec_depend>velocity_controllers</exec_depend> -->
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/bucket_hardware.xml"/>
  </export>
</package>
