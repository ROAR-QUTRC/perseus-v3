; ws2812.pio
;
; WS2812 one-wire bit stream, generated in hardware because the ~1.25us/bit
; timing is too tight for a gpio_put() loop. Side-set varies how long the pin
; stays high per bit: that high-time is what the LED reads as 0 or 1.
.program ws2812
.side_set 1

; Cycles per phase; with the clock divider in ws2812_program_init, ~1.25us/bit.
.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]  ; shift out one bit, line low
    jmp !x do_zero side 1 [T1 - 1]  ; line high; branch on the bit's value
do_one:
    jmp  bitloop   side 1 [T2 - 1]  ; bit was 1: stay high longer
do_zero:
    nop            side 0 [T2 - 1]  ; bit was 0: go low sooner
.wrap

% c-sdk {
// Starts a state machine driving a WS2812 chain on `pin` (freq: 800kHz is
// standard; rgbw: false for plain RGB pixels like the SparkFun COM-16347).
static inline void ws2812_program_init(PIO pio, uint sm, uint offset, uint pin,
                                        float freq, bool rgbw) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = ws2812_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    // Autopull after 24 bits (32 for RGBW): one colour per FIFO write.
    sm_config_set_out_shift(&c, false, true, rgbw ? 32 : 24);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    int cycles_per_bit = ws2812_T1 + ws2812_T2 + ws2812_T3;
    float div = clock_get_hz(clk_sys) / (freq * cycles_per_bit);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
