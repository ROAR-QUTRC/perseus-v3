; ws2812.pio
;
; Generates the WS2812 ("NeoPixel") one-wire bit signal in hardware, since the
; ~1.25us/bit timing (with sub-400ns high/low pulses for a 0 vs a 1) is far
; tighter than a plain gpio_put() loop can hit. The state machine
; below shifts one data bit out per loop and uses side-set to vary how long
; the pin stays high depending on whether that bit was 0 or 1 -- that
; different high-time *is* the signal WS2812 reads as 0 or 1.
.program ws2812
.side_set 1

; Cycle counts per phase, tuned (with the clock divider set in
; ws2812_program_init below) to produce the ~1.25us/bit WS2812 expects.
.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]  ; shift out one bit, line low
    jmp !x do_zero side 1 [T1 - 1]  ; line high; branch on the bit's value
do_one:
    jmp  bitloop   side 1 [T2 - 1]  ; bit was 1: stay high longer
do_zero:
    nop            side 0 [T2 - 1]  ; bit was 0: go low sooner
.wrap

% c-sdk {
// Configure and start a state machine to drive a WS2812 chain on `pin`.
//   pio    - which PIO block to use (pio0 or pio1)
//   sm     - state machine index within that block
//   offset - where this program was loaded (from pio_add_program)
//   pin    - GPIO connected to the NeoPixel's data-in line
//   freq   - WS2812 bit rate; 800kHz is the standard for these parts
//   rgbw   - true for 4-channel RGBW pixels, false for plain 3-channel RGB
//            (SparkFun COM-16347 is a plain WS2812, so rgbw = false)
static inline void ws2812_program_init(PIO pio, uint sm, uint offset, uint pin,
                                        float freq, bool rgbw) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = ws2812_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    // Shift left, autopull after 24 bits (or 32 for RGBW) so put_pixel()
    // can hand over one colour per FIFO write.
    sm_config_set_out_shift(&c, false, true, rgbw ? 32 : 24);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    int cycles_per_bit = ws2812_T1 + ws2812_T2 + ws2812_T3;
    float div = clock_get_hz(clk_sys) / (freq * cycles_per_bit);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
